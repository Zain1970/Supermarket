generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  PLATFORM_ADMIN
  STORE_OWNER
  STORE_MANAGER
  CASHIER
  INVENTORY_STAFF
  PURCHASING_STAFF
  CUSTOMER
}

enum StoreStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum SalePaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum SalePaymentMethod {
  CASH
  CARD
  TRANSFER
  CREDIT
}

enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DAMAGED
}

enum SubscriptionStatus {
  TRIALING
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum AddonStatus {
  DRAFT
  AVAILABLE
  RETIRED
}

enum StoreAddonStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  REFUNDED
}

enum PaymentPurpose {
  SUBSCRIPTION
  ADDON
}

model Store {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  status        StoreStatus       @default(PENDING)
  timezone      String            @default("Asia/Aden")
  currency      String            @default("YER")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  memberships   StoreMembership[]
  auditLogs     AuditLog[]
  categories    ProductCategory[]
  products      Product[]
  stockMovements StockMovement[]
  subscriptions Subscription[]
  storeAddons   StoreAddon[]
  payments      Payment[]
  customers     Customer[]
  sales         Sale[]
  saleReturns   SaleReturn[]

  @@index([status, createdAt])
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  displayName  String
  isPlatformAdmin Boolean @default(false)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  memberships  StoreMembership[]
  sessions     Session[]
  auditLogs    AuditLog[]        @relation("AuditActor")
  confirmedPayments Payment[]    @relation("PaymentConfirmer")
  reviewedPayments Payment[]     @relation("PaymentReviewer")
}

model StoreMembership {
  id        String         @id @default(cuid())
  storeId   String
  userId    String
  role      MembershipRole
  createdAt DateTime       @default(now())
  store     Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([storeId, userId])
  @@index([userId, role])
  @@index([storeId, role])
}

model AuditLog {
  id          String   @id @default(cuid())
  storeId     String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  reason      String?
  metadata    Json?
  createdAt   DateTime @default(now())
  store       Store?   @relation(fields: [storeId], references: [id], onDelete: Restrict)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}

model ProductCategory {
  id        String    @id @default(cuid())
  storeId   String
  name      String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Restrict)
  parent    ProductCategory? @relation("CategoryTree", fields: [storeId, parentId], references: [storeId, id], onDelete: Restrict)
  children  ProductCategory[] @relation("CategoryTree")
  products  Product[]

  @@unique([storeId, name])
  @@unique([storeId, id])
  @@index([storeId, parentId])
}

model Product {
  id             String        @id @default(cuid())
  storeId        String
  categoryId     String?
  sku            String
  barcode        String?
  name           String
  description    String?
  unit           String        @default("piece")
  costPrice      Decimal?      @db.Decimal(14, 2)
  salePrice      Decimal       @db.Decimal(14, 2)
  stockQuantity  Decimal       @default(0) @db.Decimal(14, 3)
  lowStockAt     Decimal       @default(0) @db.Decimal(14, 3)
  allowNegativeStock Boolean   @default(false)
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  category       ProductCategory? @relation(fields: [storeId, categoryId], references: [storeId, id], onDelete: Restrict)
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  saleReturnItems SaleReturnItem[]

  @@unique([storeId, sku])
  @@unique([storeId, id])
  @@unique([storeId, barcode])
  @@index([storeId, status, name])
  @@index([storeId, categoryId])
}

model StockMovement {
  id          String            @id @default(cuid())
  storeId     String
  productId   String
  type        StockMovementType
  quantity    Decimal           @db.Decimal(14, 3)
  reason      String
  reference   String?
  idempotencyKey String
  requestHash String
  actorUserId String?
  createdAt   DateTime          @default(now())
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  product     Product           @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Restrict)

  @@index([storeId, createdAt])
  @@index([storeId, productId, createdAt])
  @@index([reference])
  @@unique([storeId, idempotencyKey])
}


model Customer {
  id            String   @id @default(cuid())
  storeId       String
  name          String
  phone         String?
  email         String?
  address       String?
  notes         String?
  creditLimit   Decimal  @default(0) @db.Decimal(14, 2)
  creditBalance Decimal  @default(0) @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  sales         Sale[]

  @@unique([storeId, id])
  @@unique([storeId, phone])
  @@index([storeId, name])
}

model Sale {
  id              String            @id @default(cuid())
  storeId         String
  customerId      String?
  invoiceNumber   String
  status          SaleStatus        @default(COMPLETED)
  paymentStatus   SalePaymentStatus @default(UNPAID)
  subtotal        Decimal           @db.Decimal(14, 2)
  discountAmount  Decimal           @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal           @db.Decimal(14, 2)
  paidAmount      Decimal           @default(0) @db.Decimal(14, 2)
  balanceDue      Decimal           @default(0) @db.Decimal(14, 2)
  paymentMethod   SalePaymentMethod
  note            String?
  idempotencyKey  String
  requestHash     String
  actorUserId     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Restrict)
  customer        Customer?         @relation(fields: [storeId, customerId], references: [storeId, id], onDelete: Restrict)
  items           SaleItem[]
  payments        SalePayment[]
  returns         SaleReturn[]

  @@unique([storeId, id])
  @@unique([storeId, invoiceNumber])
  @@unique([storeId, idempotencyKey])
  @@index([storeId, createdAt])
  @@index([storeId, paymentStatus, createdAt])
  @@index([storeId, customerId, createdAt])
}

model SaleItem {
  id            String   @id @default(cuid())
  storeId       String
  saleId        String
  productId     String
  productName   String
  sku           String
  quantity      Decimal  @db.Decimal(14, 3)
  unitPrice     Decimal  @db.Decimal(14, 2)
  unitCost      Decimal? @db.Decimal(14, 2)
  lineTotal     Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())
  sale          Sale     @relation(fields: [storeId, saleId], references: [storeId, id], onDelete: Restrict)
  product       Product  @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Restrict)
  returnItems   SaleReturnItem[]

  @@unique([storeId, id])
  @@index([storeId, saleId])
  @@index([storeId, productId, createdAt])
}

model SalePayment {
  id          String            @id @default(cuid())
  storeId     String
  saleId      String
  amount      Decimal           @db.Decimal(14, 2)
  method      SalePaymentMethod
  reference   String?
  actorUserId     String
  idempotencyKey  String
  requestHash     String
  createdAt       DateTime          @default(now())
  sale            Sale              @relation(fields: [storeId, saleId], references: [storeId, id], onDelete: Restrict)

  @@unique([storeId, idempotencyKey])
  @@index([storeId, saleId, createdAt])
}

model Plan {
  id             String         @id @default(cuid())
  code           String         @unique
  name            String
  description     String?
  price           Decimal        @db.Decimal(14, 2)
  currency        String         @default("YER")
  billingCycle    BillingCycle   @default(MONTHLY)
  trialDays       Int            @default(0)
  limits          Json?
  features        Json?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subscriptions   Subscription[]
}

model Subscription {
  id            String             @id @default(cuid())
  storeId       String
  planId        String
  status        SubscriptionStatus @default(TRIALING)
  startsAt      DateTime           @default(now())
  trialEndsAt   DateTime?
  currentPeriodEnd DateTime?
  endedAt       DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  store         Store              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  plan          Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([storeId, status])
  @@index([status, currentPeriodEnd])
}

model Addon {
  id                String      @id @default(cuid())
  code              String      @unique
  name              String
  description       String?
  version           String      @default("1.0.0")
  status            AddonStatus @default(DRAFT)
  price             Decimal     @db.Decimal(14, 2)
  currency          String      @default("YER")
  billingCycle      BillingCycle @default(MONTHLY)
  minimumPlanCode   String?
  configSchema      Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  storeAddons       StoreAddon[]

  @@index([status, code])
}

model StoreAddon {
  id          String           @id @default(cuid())
  storeId     String
  addonId     String
  status      StoreAddonStatus @default(PENDING_PAYMENT)
  startsAt    DateTime?
  endsAt      DateTime?
  config      Json?
  activatedBy String?
  disabledReason String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Restrict)
  addon       Addon            @relation(fields: [addonId], references: [id], onDelete: Restrict)

  @@unique([storeId, addonId])
  @@index([storeId, status])
  @@index([addonId, status])
}

model Payment {
  id               String         @id @default(cuid())
  storeId          String
  purpose          PaymentPurpose
  purposeReference String
  amount           Decimal        @db.Decimal(14, 2)
  currency         String         @default("YER")
  status           PaymentStatus  @default(PENDING)
  method           String
  proofUrl         String?
  note             String?
  confirmedById    String?
  confirmedAt      DateTime?
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Restrict)
  confirmedBy      User?          @relation("PaymentConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  reviewedBy       User?          @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([storeId, status, createdAt])
  @@index([purpose, purposeReference])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  lastSeenAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}


model SaleReturn {
  id             String   @id @default(cuid())
  storeId        String
  saleId         String
  returnNumber   String
  totalAmount    Decimal  @db.Decimal(14, 2)
  reason         String
  note           String?
  idempotencyKey String
  requestHash    String
  actorUserId    String
  createdAt      DateTime @default(now())
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Restrict)
  sale           Sale     @relation(fields: [storeId, saleId], references: [storeId, id], onDelete: Restrict)
  items          SaleReturnItem[]

  @@unique([storeId, id])
  @@unique([storeId, returnNumber])
  @@unique([storeId, idempotencyKey])
  @@index([storeId, saleId, createdAt])
}

model SaleReturnItem {
  id             String   @id @default(cuid())
  storeId        String
  returnId       String
  saleItemId     String
  productId      String
  quantity       Decimal  @db.Decimal(14, 3)
  unitPrice      Decimal  @db.Decimal(14, 2)
  lineTotal      Decimal  @db.Decimal(14, 2)
  createdAt      DateTime @default(now())
  saleReturn     SaleReturn @relation(fields: [storeId, returnId], references: [storeId, id], onDelete: Restrict)
  saleItem       SaleItem   @relation(fields: [storeId, saleItemId], references: [storeId, id], onDelete: Restrict)
  product        Product    @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Restrict)

  @@index([storeId, returnId])
  @@index([storeId, saleItemId])
}
